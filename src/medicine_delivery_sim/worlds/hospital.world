<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hospital">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Minimal hospital geometry: one corridor and four fixed rooms. -->
    <model name="hospital_shell">
      <static>true</static>
      <link name="walls">
        <!-- Outer north/south walls -->
        <collision name="north_c"><pose>0 5 1 0 0 0</pose><geometry><box><size>16 0.12 2</size></box></geometry></collision>
        <visual name="north_v"><pose>0 5 1 0 0 0</pose><geometry><box><size>16 0.12 2</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -1.5 1 0 0 0</pose><geometry><box><size>16 0.12 2</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -1.5 1 0 0 0</pose><geometry><box><size>16 0.12 2</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <!-- End walls -->
        <collision name="west_c"><pose>-8 1.75 1 0 0 0</pose><geometry><box><size>0.12 6.5 2</size></box></geometry></collision>
        <visual name="west_v"><pose>-8 1.75 1 0 0 0</pose><geometry><box><size>0.12 6.5 2</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <collision name="east_c"><pose>8 1.75 1 0 0 0</pose><geometry><box><size>0.12 6.5 2</size></box></geometry></collision>
        <visual name="east_v"><pose>8 1.75 1 0 0 0</pose><geometry><box><size>0.12 6.5 2</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

        <!-- Room divider walls at x = -4, 0, 4 -->
        <collision name="div1_c"><pose>-4 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry></collision>
        <visual name="div1_v"><pose>-4 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry><material><ambient>0.82 0.84 0.88 1</ambient><diffuse>0.82 0.84 0.88 1</diffuse></material></visual>
        <collision name="div2_c"><pose>0 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry></collision>
        <visual name="div2_v"><pose>0 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry><material><ambient>0.82 0.84 0.88 1</ambient><diffuse>0.82 0.84 0.88 1</diffuse></material></visual>
        <collision name="div3_c"><pose>4 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry></collision>
        <visual name="div3_v"><pose>4 3 1 0 0 0</pose><geometry><box><size>0.12 4 2</size></box></geometry><material><ambient>0.82 0.84 0.88 1</ambient><diffuse>0.82 0.84 0.88 1</diffuse></material></visual>

        <!-- Front walls, each with a 1.3 m doorway centered on the room. -->
        <!-- Room 1 -->
        <collision name="r1_front_l_c"><pose>-7.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r1_front_l_v"><pose>-7.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <collision name="r1_front_r_c"><pose>-4.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r1_front_r_v"><pose>-4.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <!-- Room 2 -->
        <collision name="r2_front_l_c"><pose>-3.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r2_front_l_v"><pose>-3.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <collision name="r2_front_r_c"><pose>-0.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r2_front_r_v"><pose>-0.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <!-- Room 3 -->
        <collision name="r3_front_l_c"><pose>0.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r3_front_l_v"><pose>0.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <collision name="r3_front_r_c"><pose>3.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r3_front_r_v"><pose>3.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <!-- Room 4 -->
        <collision name="r4_front_l_c"><pose>4.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r4_front_l_v"><pose>4.675 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
        <collision name="r4_front_r_c"><pose>7.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></collision>
        <visual name="r4_front_r_v"><pose>7.325 1 1 0 0 0</pose><geometry><box><size>1.35 0.12 2</size></box></geometry></visual>
      </link>
    </model>

    <!-- Beds: intentionally offset to the right of the LiDAR patient-check line. -->
    <model name="bed_m6"><static>true</static><pose>-5.15 3.8 0 0 0 0</pose>
      <link name="bed">
        <collision name="base_c"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry><material><ambient>0.35 0.55 0.75 1</ambient><diffuse>0.35 0.55 0.75 1</diffuse></material></visual>
        <collision name="pillow_c"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry></collision>
        <visual name="pillow_v"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bed_m2"><static>true</static><pose>-1.15 3.8 0 0 0 0</pose>
      <link name="bed">
        <collision name="base_c"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry><material><ambient>0.35 0.55 0.75 1</ambient><diffuse>0.35 0.55 0.75 1</diffuse></material></visual>
        <collision name="pillow_c"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry></collision>
        <visual name="pillow_v"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bed_2"><static>true</static><pose>2.85 3.8 0 0 0 0</pose>
      <link name="bed">
        <collision name="base_c"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry><material><ambient>0.35 0.55 0.75 1</ambient><diffuse>0.35 0.55 0.75 1</diffuse></material></visual>
        <collision name="pillow_c"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry></collision>
        <visual name="pillow_v"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bed_6"><static>true</static><pose>6.85 3.8 0 0 0 0</pose>
      <link name="bed">
        <collision name="base_c"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>1.0 1.8 0.60</size></box></geometry><material><ambient>0.35 0.55 0.75 1</ambient><diffuse>0.35 0.55 0.75 1</diffuse></material></visual>
        <collision name="pillow_c"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry></collision>
        <visual name="pillow_v"><pose>0 0.55 0.66 0 0 0</pose><geometry><box><size>0.75 0.45 0.12</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Simulated patients: Room 1 and Room 3 occupied; Room 2 and Room 4 empty. -->
    <model name="patient_room_1"><static>true</static><pose>-6 3.15 0 0 0 0</pose>
      <link name="patient"><collision name="c"><pose>0 0 0.60 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.20</length></cylinder></geometry></collision>
      <visual name="v"><pose>0 0 0.60 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.20</length></cylinder></geometry><material><ambient>0.85 0.45 0.25 1</ambient><diffuse>0.85 0.45 0.25 1</diffuse></material></visual></link>
    </model>
    <model name="patient_room_3"><static>true</static><pose>2 3.15 0 0 0 0</pose>
      <link name="patient"><collision name="c"><pose>0 0 0.60 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.20</length></cylinder></geometry></collision>
      <visual name="v"><pose>0 0 0.60 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.20</length></cylinder></geometry><material><ambient>0.85 0.45 0.25 1</ambient><diffuse>0.85 0.45 0.25 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
